<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- StudyLock Dark Theme — Material 3 per owner-approved D-09/D-10 -->
    <!-- Base colors: #181C14, #3C3D37, #697565, #ECDFCC -->

    <style name="Theme.StudyLock" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Primary -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>
        <item name="colorPrimaryContainer">@color/colorPrimaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/colorOnPrimaryContainer</item>

        <!-- Secondary -->
        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="colorOnSecondary">@color/colorOnSecondary</item>
        <item name="colorSecondaryContainer">@color/colorSecondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/colorOnSecondaryContainer</item>

        <!-- Tertiary -->
        <item name="colorTertiary">@color/colorTertiary</item>
        <item name="colorOnTertiary">@color/colorOnTertiary</item>
        <item name="colorTertiaryContainer">@color/colorTertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/colorOnTertiaryContainer</item>

        <!-- Surface -->
        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorOnSurface">@color/colorOnSurface</item>
        <item name="colorSurfaceVariant">@color/colorSurfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/colorOnSurfaceVariant</item>

        <!-- Background -->
        <item name="android:colorBackground">@color/colorBackground</item>
        <item name="colorOnBackground">@color/colorOnBackground</item>

        <!-- Error -->
        <item name="colorError">@color/colorError</item>
        <item name="colorOnError">@color/colorOnError</item>
        <item name="colorErrorContainer">@color/colorErrorContainer</item>
        <item name="colorOnErrorContainer">@color/colorOnErrorContainer</item>

        <!-- Outline -->
        <item name="colorOutline">@color/colorOutline</item>
        <item name="colorOutlineVariant">@color/colorOutlineVariant</item>

        <!-- Window -->
        <item name="android:windowBackground">@color/colorBackground</item>
        <item name="android:statusBarColor">@color/colorBackground</item>
        <item name="android:navigationBarColor">@color/colorBackground</item>

        <!-- StudyLock semantic aliases -->
        <item name="sl_color_surface_quiet">@color/sl_color_surface_quiet</item>
        <item name="sl_color_surface_elevated">@color/sl_color_surface_elevated</item>
        <item name="sl_color_text_primary">@color/sl_color_text_primary</item>
        <item name="sl_color_text_secondary">@color/sl_color_text_secondary</item>
        <item name="sl_color_accent_primary">@color/sl_color_accent_primary</item>
        <item name="sl_color_accent_light">@color/sl_color_accent_light</item>

        <!-- Typography — M3 scale -->
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.StudyLock.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.StudyLock.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.StudyLock.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.StudyLock.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.StudyLock.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.StudyLock.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.StudyLock.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.StudyLock.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.StudyLock.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.StudyLock.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.StudyLock.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.StudyLock.LabelSmall</item>

        <!-- ADHD-friendly: minimal animation -->
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- Splash theme for launch -->
    <style name="Theme.StudyLock.Splash" parent="Theme.StudyLock">
        <item name="android:windowBackground">@drawable/ic_launcher</item>
    </style>
</resources>
