<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- StudyLock M3 Typography Scale — per owner-approved D-09/D-10 -->
    <!-- ADHD-friendly: scalable sp units, clear hierarchy, readable sizes -->

    <!-- Headlines -->
    <style name="TextAppearance.StudyLock.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textSize">32sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">?attr/sl_color_text_primary</item>
    </style>

    <style name="TextAppearance.StudyLock.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">28sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">?attr/sl_color_text_primary</item>
    </style>

    <style name="TextAppearance.StudyLock.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">24sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">?attr/sl_color_text_primary</item>
    </style>

    <!-- Titles -->
    <style name="TextAppearance.StudyLock.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">?attr/sl_color_text_primary</item>
    </style>

    <style name="TextAppearance.StudyLock.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">?attr/sl_color_text_primary</item>
    </style>

    <style name="TextAppearance.StudyLock.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">?attr/sl_color_text_secondary</item>
    </style>

    <!-- Body -->
    <style name="TextAppearance.StudyLock.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">?attr/sl_color_text_primary</item>
        <item name="android:lineHeight">24sp</item>
    </style>

    <style name="TextAppearance.StudyLock.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">?attr/sl_color_text_primary</item>
        <item name="android:lineHeight">20sp</item>
    </style>

    <style name="TextAppearance.StudyLock.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">?attr/sl_color_text_secondary</item>
        <item name="android:lineHeight">16sp</item>
    </style>

    <!-- Labels -->
    <style name="TextAppearance.StudyLock.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">?attr/sl_color_text_primary</item>
    </style>

    <style name="TextAppearance.StudyLock.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">?attr/sl_color_text_secondary</item>
    </style>

    <style name="TextAppearance.StudyLock.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">?attr/sl_color_text_secondary</item>
    </style>

    <!-- StudyLock-specific text appearances -->
    <style name="TextAppearance.StudyLock.SessionTimer" parent="TextAppearance.StudyLock.HeadlineLarge">
        <item name="android:textSize">48sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">?attr/sl_color_text_primary</item>
    </style>

    <style name="TextAppearance.StudyLock.SessionProgress" parent="TextAppearance.StudyLock.BodyMedium">
        <item name="android:textColor">?attr/sl_color_text_secondary</item>
    </style>

    <style name="TextAppearance.StudyLock.ReasonText" parent="TextAppearance.StudyLock.BodySmall">
        <item name="android:textColor">?attr/sl_color_text_secondary</item>
        <item name="android:textStyle">italic</item>
    </style>
</resources>
